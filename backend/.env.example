APP_NAME=CourierOps
ENVIRONMENT=production
APP_TIMEZONE=Asia/Kolkata
MANUAL_NDR_ONLY=true
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/courierops
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://your-vercel-app.vercel.app","http://localhost:5173"]
INITIAL_ADMIN_EMAIL=admin@courierops.com
INITIAL_ADMIN_PASSWORD=ChangeMe@12345
CENTRAL_COURIER_API_URL=https://central-courier-api.onrender.com
CENTRAL_COURIER_API_KEY=replace-with-a-rotated-server-side-key
CENTRAL_COURIER_API_TIMEOUT_SECONDS=20
CENTRAL_COURIER_NDR_REFRESH_SECONDS=300
